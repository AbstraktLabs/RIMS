# ─────────────────────────────────────────────────────────────
# Retail IMS (RIMS) — environment variables
# Copy to `.env` for local development and fill in real values.
# Never commit real secrets. This database must be separate from
# the Pharmacy IMS database.
# ─────────────────────────────────────────────────────────────

# App
APP_NAME="Retail IMS"
APP_URL=http://localhost:3000

# PostgreSQL (dedicated RIMS database)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rims_dev

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379

# Auth — use long random strings, e.g. `openssl rand -base64 48`
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SUPER_ADMIN_TOKEN_SECRET=

# Number of reverse proxies / load balancers in front of the app. Used to read the
# real client IP from X-Forwarded-For for rate limiting.
TRUSTED_PROXY_COUNT=1

# Local test runs only (ignored in production): comma-separated rate limits to
# switch off. `pnpm test:e2e` needs RATE_LIMIT_SKIP=register,login-ip because it
# signs up and signs in many times from one machine.
RATE_LIMIT_SKIP=

# Tenant trial length for new sign-ups (days)
TRIAL_DAYS=14

# Cloudinary (organization logos, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rims

# SMTP (password reset, staff invites)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Retail IMS <no-reply@example.com>"

# Seeding (`pnpm db:seed`) — first platform super admin.
# Leave blank to skip creating a super admin.
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
